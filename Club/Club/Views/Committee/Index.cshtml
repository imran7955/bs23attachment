@model IEnumerable<Club.Models.CommitteeMember>

@{
    ViewData["Title"] = "Committee Members";
}

<div class="container my-5">
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body d-flex justify-content-between align-items-center p-4">
            <div>
                <h2 class="text-dark fw-bold mb-1">Committee Structure</h2>
                <p class="text-muted mb-0 small">Manage and view the official registered executive profiles of the club.</p>
            </div>
            <a asp-action="Add" class="btn btn-primary px-4 py-2 fw-semibold shadow-sm">
                <i class="bi bi-person-plus-fill me-2"></i>Add New Member
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-primary border-bottom text-uppercase fs-7 tracking-wider">
                        <tr>
                            <th class="ps-4 py-3 text-secondary fw-bold">Full Name</th>
                            <th class="py-3 text-secondary fw-bold">Department</th>
                            <th class="py-3 text-secondary fw-bold">Role / Designation</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-center py-5 text-muted">
                                    <div class="py-3">
                                        <p class="mb-0 fw-medium">No committee members found.</p>
                                        <small class="text-muted">Click "Add New Member" to begin populate this register.</small>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var member in Model)
                            {
                                <tr class="border-bottom">
                                    <td class="ps-4 py-3 fw-semibold text-dark">@member.Name</td>
                                    <td class="py-3"><span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-20 px-2 py-1">@member.Department</span></td>
                                    <td class="py-3 text-primary fw-medium">@member.Role</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>