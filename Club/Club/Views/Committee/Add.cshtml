@model Club.Models.CommitteeMember

@{
    ViewData["Title"] = "Add Committee Member";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow border-0">
                <div class="card-header bg-white border-bottom border-2 border-primary py-3 px-4">
                    <h4 class="mb-1 fw-bold text-dark">Member Registration</h4>
                    <p class="text-muted mb-0 small">Fill out the fields below to add a member to the tracking system.</p>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Add" method="post" autocomplete="off">

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold text-secondary small"></label>
                            <div class="input-group">
                                <input asp-for="Name" class="form-control border-end-0 bg-light bg-opacity-50 focus-none" placeholder="e.g. John Doe" />
                                <span class="input-group-text bg-light bg-opacity-50 border-start-0 text-muted"><i class="bi bi-person"></i></span>
                            </div>
                            <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Department" class="form-label fw-semibold text-secondary small"></label>
                            <input asp-for="Department" class="form-control bg-light bg-opacity-50" placeholder="e.g. CSE, EEE, ME" />
                            <span asp-validation-for="Department" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Role" class="form-label fw-semibold text-secondary small"></label>
                            <input asp-for="Role" class="form-control bg-light bg-opacity-50" placeholder="e.g. President, Executive Member" />
                            <span asp-validation-for="Role" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-success px-4 shadow-sm">
                                Save Profile
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}