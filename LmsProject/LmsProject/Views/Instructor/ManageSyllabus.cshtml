@model LmsProject.Models.Course

@{
    ViewData["Title"] = "Manage Course Syllabus";
}

<div class="container" style="max-width: 900px;">
    <div class="mb-4">
        <a href="@Url.Action("Dashboard", "Instructor")" class="text-decoration-none text-muted small">← Return to Dashboard</a>
        <h2 class="mt-2 text-dark fw-bold">Syllabus Sequence Builder</h2>
        <span class="badge bg-primary text-uppercase font-monospace">Track: @Model.Title</span>
    </div>

    <div class="row g-4">
        <div class="col-md-5">
            <div class="card shadow-sm border sticky-top" style="top: 100px;">
                <div class="card-header bg-light fw-bold text-dark">Add New Video Entry</div>
                <div class="card-body">
                    <form method="post" action="@Url.Action("AddMaterialToCourse", "Instructor")">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="courseId" value="@Model.Id" />

                        <div class="mb-2">
                            <label class="form-label small fw-bold text-muted mb-1">Material / Topic Title</label>
                            <input type="text" name="title" class="form-control form-control-sm" placeholder="e.g. Setting up project routes" required />
                        </div>

                        <div class="mb-2">
                            <label class="form-label small fw-bold text-muted mb-1">YouTube Link URL</label>
                            <input type="url" name="url" class="form-control form-control-sm" placeholder="https://www.youtube.com/watch?..." required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted mb-1">Sequence Position No.</label>
                            <input type="number" name="position" class="form-control form-control-sm" value="@(Model.CourseMaterials.Count + 1)" min="1" required />
                            <div class="form-text text-muted" style="font-size: 0.7rem;">Defines the step priority order on the user screen.</div>
                        </div>

                        <button type="submit" class="btn btn-sm btn-dark w-100 fw-bold">Append to Course Track</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <div class="card shadow-sm border">
                <div class="card-header bg-white fw-bold text-secondary text-uppercase font-monospace small">Structured Video Flow Paths</div>
                <div class="card-body p-0">
                    @if (!Model.CourseMaterials.Any())
                    {
                        <div class="text-center py-5 text-muted small">No items added to this track sequence yet. Use the addition form panel to start building.</div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var cm in Model.CourseMaterials.OrderBy(m => m.Position))
                            {
                                <li class="list-group-item p-3 d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center">
                                        <span class="badge bg-secondary rounded-pill me-3" style="min-width: 30px;">#@cm.Position</span>
                                        <div>
                                            <h6 class="mb-0 fw-bold text-dark font-monospace small">@cm.Material.Title</h6>
                                            <a href="@cm.Material.YouTubeLink" target="_blank" class="text-danger small text-decoration-none" style="font-size: 0.75rem;">▶ View Link Target</a>
                                        </div>
                                    </div>

                                    <form method="post" action="@Url.Action("RemoveMaterial", "Instructor")" onsubmit="return confirm('Remove this structural topic entry?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="courseId" value="@Model.Id" />
                                        <input type="hidden" name="materialId" value="@cm.MaterialId" />
                                        <button type="submit" class="btn btn-sm btn-link text-danger text-decoration-none px-1 py-0" style="font-size: 0.8rem;">Remove</button>
                                    </form>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>
</div>