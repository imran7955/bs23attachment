@model Course

@{
    ViewData["Title"] = "Create Course";
    var domains = ViewBag.Domains as List<string> ?? new List<string>();
    var instructors = ViewBag.Instructors as List<Instructor> ?? new List<Instructor>();
}

<div class="container" style="max-width: 700px;">
    <div class="card shadow-sm border mt-4">
        <div class="card-header bg-dark text-white p-3">
            <h5 class="mb-0 fw-bold font-monospace">Setup New Learning Course</h5>
        </div>
        <div class="card-body p-4">
            <form method="post" action="@Url.Action("CreateCourse", "Instructor")">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label fw-bold text-secondary">Course Title</label>
                    <input type="text" name="Title" class="form-control" placeholder="e.g. Advanced Graph Structures" required />
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold text-secondary">Course Domain</label>
                    <select name="Domain" class="form-select" required>
                        <option value="" disabled selected>-- Select Domain Category --</option>
                        @foreach (var domain in domains)
                        {
                            <option value="@domain">@domain</option>
                        }
                    </select>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold text-secondary">Course Description</label>
                    <textarea name="Description" class="form-control" rows="3" placeholder="Enter a paragraph description detailing what students will learn in this track..."></textarea>
                </div>

                <div class="mb-4 p-3 bg-light rounded border">
                    <label class="form-label fw-bold text-dark d-block mb-2">Assign Instructors <small class="text-muted fw-normal">(Select all that apply)</small></label>

                    @if (!instructors.Any())
                    {
                        <div class="text-danger small">⚠️ No faculty found. Please register an instructor on the main dashboard sidebar first.</div>
                    }
                    else
                    {
                        <div class="row row-cols-1 row-cols-sm-2 g-2" style="max-height: 150px; overflow-y: auto;">
                            @foreach (var inst in instructors)
                            {
                                <div class="col">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="selectedInstructors" value="@inst.Id" id="inst_@inst.Id">
                                        <label class="form-check-label small text-dark" for="inst_@inst.Id">
                                            👤 @inst.Name
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4 fw-bold">Publish Course</button>
                    <a href="@Url.Action("Dashboard", "Instructor")" class="btn btn-outline-secondary px-4">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>